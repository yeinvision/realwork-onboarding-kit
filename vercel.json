{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "framework": "static",
  "headers": [
    {
      "source": "/(.*)\\.html?",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
